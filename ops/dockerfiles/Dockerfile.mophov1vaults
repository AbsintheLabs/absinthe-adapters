FROM node:20-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

# Copy workspace files needed for dependency resolution
FROM base AS deps
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY tsconfig.base.json ./
COPY packages/common/package.json ./packages/common/
COPY packages/common/tsconfig.json ./packages/common/
COPY projects/morphov1vaults/package.json ./projects/morphov1vaults/
COPY projects/morphov1vaults/tsconfig.json ./projects/morphov1vaults/

# Install all dependencies (including workspace deps)
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --no-frozen-lockfile

# Build stage - build common package and current project
FROM base AS build
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY tsconfig.base.json ./
COPY packages/ ./packages/
COPY projects/morphov1vaults/ ./projects/morphov1vaults/

# Copy node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/common/node_modules ./packages/common/node_modules
COPY --from=deps /app/projects/morphov1vaults/node_modules ./projects/morphov1vaults/node_modules

# Generate TypeScript clients for morphov1vaults project ABIs and codegen
WORKDIR /app/projects/morphov1vaults
RUN pnpm squid-evm-typegen ./src/abi/ abi/*.json
RUN pnpm squid-typeorm-codegen

# Build the common package first, then morphov1vaults
WORKDIR /app
RUN pnpm --filter @absinthe/common build
RUN pnpm --filter @absinthe/morphov1vaults build

# Production stage
FROM base AS production
WORKDIR /app

# Copy only production dependencies
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/common/node_modules ./packages/common/node_modules
COPY --from=deps /app/projects/morphov1vaults/node_modules ./projects/morphov1vaults/node_modules

# Copy built artifacts
COPY --from=build /app/packages/common/lib ./packages/common/lib
COPY --from=build /app/packages/common/package.json ./packages/common/
COPY --from=build /app/projects/morphov1vaults/lib ./projects/morphov1vaults/lib
COPY --from=build /app/projects/morphov1vaults/package.json ./projects/morphov1vaults/

# Copy source files needed for migrations
COPY --from=build /app/projects/morphov1vaults/src ./projects/morphov1vaults/src
COPY --from=build /app/projects/morphov1vaults/schema.graphql ./projects/morphov1vaults/
COPY --from=build /app/projects/morphov1vaults/tsconfig.json ./projects/morphov1vaults/

WORKDIR /app/projects/morphov1vaults

# Use exec form and proper exit handling
CMD ["sh", "-c", "set -e; (pnpm migration:generate || echo 'No migration changes found'); pnpm migration:apply; exec node lib/main.js"]
